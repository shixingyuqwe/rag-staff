# 环境变量示例 - 复制为 .env.development 或 .env.production 后填入实际值

PUBLIC_PATH=/
PUBLIC_WECOM_AUTH_BASE=http://localhost:3001
PUBLIC_WECOM_CORP_ID=your_wecom_corp_id

# MarketingForce AI 平台配置
PUBLIC_MF_API_BASE=/mf-api
PUBLIC_MF_API_TOKEN=your_mf_api_token

# 升降级评分智能体
PUBLIC_MF_SCORING_AGENT_SN=your_scoring_agent_sn
PUBLIC_MF_SCORING_VERSION_SN=your_scoring_version_sn

# 日志智能体
PUBLIC_MF_LOG_AGENT_SN=your_log_agent_sn
PUBLIC_MF_LOG_VERSION_SN=your_log_version_sn

# RAG 服务 API 地址
PUBLIC_RAG_API_BASE=http://127.0.0.1:8000
